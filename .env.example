# Environment Variables for NutriSculpt
# Copy this file to .env.local and fill in your actual values.

# Next.js environment
NODE_ENV=development

# Public enquiry submission (existing integration; optional if using local enquiry storage only)
# GOOGLE_APPS_SCRIPT_URL=

# Admin dashboard authentication (required for /admin/enquiries)
# Use a strong random secret (32+ bytes). Keep it server-side only.
# ADMIN_SESSION_SECRET=
# Authorized administrator email (single-owner setup)
# ADMIN_EMAIL=
# Authorized administrator password hash (PBKDF2-SHA256, format: pbkdf2$iterations$saltBase64$hashBase64)
# Generate with: node scripts/generate-admin-hash.js "your-password"
# ADMIN_PASSWORD_HASH=

# Enquiry duplicate detection (required in production)
# Use a dedicated, strong random secret (32+ bytes). Keep it server-side only.
# In production this is required and is NOT replaced by ADMIN_SESSION_SECRET.
# Without it, enquiry submission fails closed with HTTP 503.
# ENQUIRY_FINGERPRINT_SECRET=

# Neon PostgreSQL (required for production persistence on Vercel/serverless)
# DATABASE_URL=postgresql://... (direct connection; used for schema/migrations when needed)
# DATABASE_URL_POOLED=postgresql://...-pooler... (preferred for serverless app queries)

# Optional: path to enquiry data file for local dev fallback (defaults to data/enquiries.json)
# Only used when DATABASE_URL/DATABASE_URL_POOLED are not set in non-production environments.
# ENQUIRIES_DATA_PATH=